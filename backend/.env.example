# ==============================================================================
# PAYLEAK BACKEND CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/payleak
MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# PAYLEAK DEDICATED PAYPAL SANDBOX APP CREDENTIALS
# ==============================================================================
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BUSINESS_EMAIL=your_sandbox_merchant@business.example.com
PAYPAL_BUYER_EMAIL=your_sandbox_buyer@personal.example.com
PAYPAL_BUYER_PASSWORD=your_sandbox_buyer_password
PAYPAL_WEBHOOK_ID=
PAYPAL_ACCOUNT_OWNER_USER_ID=

# ==============================================================================
# AI SERVICE
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
